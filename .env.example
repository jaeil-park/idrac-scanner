# iDRAC 폴백 자격증명 목록 (JSON 배열)
# 형식: [["username","password"], ...]
# 여기에 실제 비밀번호를 입력하고 .env 파일을 Docker Compose에 연결하세요.
# 이 파일(.env.example)은 예시용이며 GitHub에 커밋해도 안전합니다.
IDRAC_FALLBACK_CREDS=[["root","calvin"]]

# Flask 포트 (기본값: 5010)
PORT=5010

# DB 경로 (Docker 볼륨 마운트 경로)
DB_PATH=/data/known_devices.db
